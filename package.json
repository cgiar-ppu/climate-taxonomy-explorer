{
  "name": "climate-taxonomy-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-data": "python3 scripts/prepare-data.py",
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host 127.0.0.1 --port 5198",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
